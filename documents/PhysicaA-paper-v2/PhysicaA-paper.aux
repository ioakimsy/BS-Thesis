\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Return-map fit statistics for the broadcast (TI) and nearest-neighbor (PI, inner corner) regimes in the four cases of Fig.~\ref {fig:Return map}, and for the empirical data. Simulation fits impose $h(1)=1$; the broadcast form $h(f)=f+a_0(1-f)$ has the single free parameter $a_0$, and the nearest-neighbor form $h(f)=f+(1-f)(a_0-a_2 f)$ has free parameters $a_0$ and $a_2$. Each of the 20 runs is fitted separately, since consecutive points of one run are correlated; simulation coefficients are the mean over runs $\pm $ the standard error of the mean, and $R^2$ is the mean over runs. The empirical fits are free quadratics $h(f)=a_0+a_1 f+a_2 f^2$ to the individual students (896 pre/post pairs) and to the class means (thirteen classes, class 9 excluded), with one standard error from the fit. For $\delta \lambda >0$ the broadcast $a_0$ is an effective constant (Table~\ref {tbl:ti gain}).}}{10}{table.3}\protected@file@percent }
\newlabel{tbl:returnmapfits}{{3}{10}{Return-map fit statistics for the broadcast (TI) and nearest-neighbor (PI, inner corner) regimes in the four cases of Fig.~\ref {fig:Return map}, and for the empirical data. Simulation fits impose $h(1)=1$; the broadcast form $h(f)=f+a_0(1-f)$ has the single free parameter $a_0$, and the nearest-neighbor form $h(f)=f+(1-f)(a_0-a_2 f)$ has free parameters $a_0$ and $a_2$. Each of the 20 runs is fitted separately, since consecutive points of one run are correlated; simulation coefficients are the mean over runs $\pm $ the standard error of the mean, and $R^2$ is the mean over runs. The empirical fits are free quadratics $h(f)=a_0+a_1 f+a_2 f^2$ to the individual students (896 pre/post pairs) and to the class means (thirteen classes, class 9 excluded), with one standard error from the fit. For $\delta \lambda >0$ the broadcast $a_0$ is an effective constant (Table~\ref {tbl:ti gain})}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Constant broadcast gain $a_0$ of Eq.~\eqref  {eq:ti-return-map} compared with the exact gain $g$ of Eq.~\eqref  {eq:ti-exact-gain}, for $L=128$: the fitted $a_0$ (mean over 20 runs) relative to $\rho _0\lambda _0$; the ratio $g_{\rm  start}/g_{\rm  end}$ of the exact gain at the start of the relaxation, $g(0)=\rho _0\lambda _0$, to its final value, $\lim _{t\to \infty }g(t)=\rho _0(\lambda _0-\delta \lambda )$; and the largest relative difference between the exact and the constant gain over the relaxation, $\max _t|g(t)-a_0|/a_0$. Ranges are over $\rho _0=0.1$, $0.5$, and $0.9$.}}{10}{table.4}\protected@file@percent }
\newlabel{tbl:ti gain}{{4}{10}{Constant broadcast gain $a_0$ of Eq.~\eqref {eq:ti-return-map} compared with the exact gain $g$ of Eq.~\eqref {eq:ti-exact-gain}, for $L=128$: the fitted $a_0$ (mean over 20 runs) relative to $\rho _0\lambda _0$; the ratio $g_{\rm start}/g_{\rm end}$ of the exact gain at the start of the relaxation, $g(0)=\rho _0\lambda _0$, to its final value, $\lim _{t\to \infty }g(t)=\rho _0(\lambda _0-\delta \lambda )$; and the largest relative difference between the exact and the constant gain over the relaxation, $\max _t|g(t)-a_0|/a_0$. Ranges are over $\rho _0=0.1$, $0.5$, and $0.9$}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Flowchart for the pCA algorithm used in this work. The broadcast (TI) and nearest-neighbor (PI) regimes differ in how the update probability $P_{i,j}$ is determined (Eqs.~\eqref  {eq:TI-mode-probability} and~\eqref  {eq:BPCA PI learning probability}, respectively). The next-step states $s'_{i,j}$ are applied to all agents together at the end of each time step (synchronous update), and the simulation ends once every agent has learned. }}{11}{figure.1}\protected@file@percent }
\newlabel{fig:pCA-flowchart}{{1}{11}{Flowchart for the pCA algorithm used in this work. The broadcast (TI) and nearest-neighbor (PI) regimes differ in how the update probability $P_{i,j}$ is determined (Eqs.~\eqref {eq:TI-mode-probability} and~\eqref {eq:BPCA PI learning probability}, respectively). The next-step states $s'_{i,j}$ are applied to all agents together at the end of each time step (synchronous update), and the simulation ends once every agent has learned}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Seating arrangements (SAs) considered for the nearest-neighbor (PI) regime. Dots represent the initial positions of learned agents ($s_{i,j}=1$) in the lattice. Agents are otherwise arranged in a rectangular lattice pattern (shown here as square for brevity). The random case shown is one of many possible arrangements. }}{11}{figure.2}\protected@file@percent }
\newlabel{fig:PI-SAs}{{2}{11}{Seating arrangements (SAs) considered for the nearest-neighbor (PI) regime. Dots represent the initial positions of learned agents ($s_{i,j}=1$) in the lattice. Agents are otherwise arranged in a rectangular lattice pattern (shown here as square for brevity). The random case shown is one of many possible arrangements}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Monotonic increase of the learned agent fraction over iteration number for both interaction regimes. The horizontal axis (iteration number) is shown on a base-2 logarithmic scale ($2^0, 2^1, 2^2, \dots  $). Blue corresponds to the broadcast (TI) regime; all other colors correspond to the nearest-neighbor (PI) regime. Bands represent one standard deviation across $20$ independent randomized runs. (a)~Effect of lattice side length $L$ (line width proportional to lattice side length $L$); the inner corner SA is used for the nearest-neighbor regime; $\rho _0=0.5$, $\delta \lambda =0.2$. (b)~Effect of seating arrangement (SA) for a fixed lattice side length; colors indicate different SAs (yellow-orange: inner corner, orange: center, green: outer corner, pink: random); $\rho _0=0.5$, $\delta \lambda =0.2$. (c)~Effect of coupling strength $\rho _0$; inner corner SA, $L=64$, $\delta \lambda =0.2$. (d)~Effect of heterogeneity parameter $\delta \lambda $; inner corner SA, $L=64$, $\rho _0=0.5$. }}{12}{figure.3}\protected@file@percent }
\newlabel{fig:comparison size}{{3}{12}{Monotonic increase of the learned agent fraction over iteration number for both interaction regimes. The horizontal axis (iteration number) is shown on a base-2 logarithmic scale ($2^0, 2^1, 2^2, \dots $). Blue corresponds to the broadcast (TI) regime; all other colors correspond to the nearest-neighbor (PI) regime. Bands represent one standard deviation across $20$ independent randomized runs. (a)~Effect of lattice side length $L$ (line width proportional to lattice side length $L$); the inner corner SA is used for the nearest-neighbor regime; $\rho _0=0.5$, $\delta \lambda =0.2$. (b)~Effect of seating arrangement (SA) for a fixed lattice side length; colors indicate different SAs (yellow-orange: inner corner, orange: center, green: outer corner, pink: random); $\rho _0=0.5$, $\delta \lambda =0.2$. (c)~Effect of coupling strength $\rho _0$; inner corner SA, $L=64$, $\delta \lambda =0.2$. (d)~Effect of heterogeneity parameter $\delta \lambda $; inner corner SA, $L=64$, $\rho _0=0.5$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Fraction of learned agents among the high-$\lambda $ agents (thick solid lines) and the low-$\lambda $ agents (thick dashed lines), and in the whole population (thin lines), for the broadcast (blue) and nearest-neighbor (orange, inner corner arrangement) regimes, with $L=128$, $\rho _0=0.5$ (top row) and $\rho _0=0.1$ (bottom row), and $\delta \lambda =0.2$, $0.4$, and $0.49$ (left to right); means over 20 runs. The iteration axis is logarithmic (base~2).}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:class split}{{4}{13}{Fraction of learned agents among the high-$\lambda $ agents (thick solid lines) and the low-$\lambda $ agents (thick dashed lines), and in the whole population (thin lines), for the broadcast (blue) and nearest-neighbor (orange, inner corner arrangement) regimes, with $L=128$, $\rho _0=0.5$ (top row) and $\rho _0=0.1$ (bottom row), and $\delta \lambda =0.2$, $0.4$, and $0.49$ (left to right); means over 20 runs. The iteration axis is logarithmic (base~2)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Representative spatial configurations of the lattice ($L=32$, $\rho _0=0.3$, $\delta \lambda =0.2$) at iteration numbers $t=2,8,16,32$, and $54$, for the broadcast (top row, ``Traditional'') and nearest-neighbor (bottom row, ``Peer'') regimes, from one pair of runs with the same four initially learned agents (inner corner arrangement) and the same assignment of learning rates. Light blue indicates unlearned agents; blue and dark navy indicate learned agents with slow and fast learning rates $\lambda $, respectively. }}{13}{figure.5}\protected@file@percent }
\newlabel{fig:spatial config}{{5}{13}{Representative spatial configurations of the lattice ($L=32$, $\rho _0=0.3$, $\delta \lambda =0.2$) at iteration numbers $t=2,8,16,32$, and $54$, for the broadcast (top row, ``Traditional'') and nearest-neighbor (bottom row, ``Peer'') regimes, from one pair of runs with the same four initially learned agents (inner corner arrangement) and the same assignment of learning rates. Light blue indicates unlearned agents; blue and dark navy indicate learned agents with slow and fast learning rates $\lambda $, respectively}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Total relaxation time $t_{\rm  max}$ (top row, last agent learned) and time $t_{95}$ for $95\%$ of agents to learn (bottom row) as functions of coupling strength $\rho _0$ and heterogeneity $\delta \lambda $, for the broadcast (blue surface) and nearest-neighbor (orange surface) regimes, for lattice side lengths $L=32$ (a,~c) and $L=128$ (b,~d); means over 20 runs. The nearest-neighbor regime uses the inner corner seating arrangement. Lower values indicate faster collective relaxation. }}{14}{figure.6}\protected@file@percent }
\newlabel{fig:Params effect summary t}{{6}{14}{Total relaxation time $t_{\rm max}$ (top row, last agent learned) and time $t_{95}$ for $95\%$ of agents to learn (bottom row) as functions of coupling strength $\rho _0$ and heterogeneity $\delta \lambda $, for the broadcast (blue surface) and nearest-neighbor (orange surface) regimes, for lattice side lengths $L=32$ (a,~c) and $L=128$ (b,~d); means over 20 runs. The nearest-neighbor regime uses the inner corner seating arrangement. Lower values indicate faster collective relaxation}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  Return map of the learned agent fraction, $f(t)$ against $f(t-1)$, in unfavorable conditions ($\rho _0=0.1$, $\delta \lambda =0.4$; top row) and favorable conditions ($\rho _0=0.9$, $\delta \lambda =0$; bottom row), for $L=32$ (left) and $L=128$ (right), so that panels in the same row differ only in system size. Blue circles represent the broadcast (TI) regime and orange squares the nearest-neighbor (PI) regime with the inner corner arrangement, 20 runs each. Pink diamonds represent individual students in the empirical data of Roxas (fourteen classes of 64 students); darker diamonds indicate overlapping points. Dashed lines show the fitted return maps: for the simulations, the constrained broadcast and nearest-neighbor forms with coefficients averaged over separate fits to each run (Table~\ref {tbl:returnmapfits}); for the empirical data, a free quadratic. The green line represents the prediction of~\citet  {nitta2019mathematical} and the gray line represents $y=x$. }}{15}{figure.7}\protected@file@percent }
\newlabel{fig:Return map}{{7}{15}{Return map of the learned agent fraction, $f(t)$ against $f(t-1)$, in unfavorable conditions ($\rho _0=0.1$, $\delta \lambda =0.4$; top row) and favorable conditions ($\rho _0=0.9$, $\delta \lambda =0$; bottom row), for $L=32$ (left) and $L=128$ (right), so that panels in the same row differ only in system size. Blue circles represent the broadcast (TI) regime and orange squares the nearest-neighbor (PI) regime with the inner corner arrangement, 20 runs each. Pink diamonds represent individual students in the empirical data of Roxas (fourteen classes of 64 students); darker diamonds indicate overlapping points. Dashed lines show the fitted return maps: for the simulations, the constrained broadcast and nearest-neighbor forms with coefficients averaged over separate fits to each run (Table~\ref {tbl:returnmapfits}); for the empirical data, a free quadratic. The green line represents the prediction of~\citet {nitta2019mathematical} and the gray line represents $y=x$}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Per-step gain of the broadcast regime, normalized by $\rho _0\lambda _0$, against the fraction of learned agents, for $L=128$, $\delta \lambda =0$, $0.2$, $0.4$, and $0.49$ (left to right), and $\rho _0=0.1$ (blue circles), $0.5$ (orange squares), and $0.9$ (green triangles). Symbols: simulation (agents newly learned divided by agents unlearned, summed over 20 runs within bins of $f$); solid lines: exact gain, Eq.~\eqref  {eq:ti-exact-gain}; dashed lines: fitted constant $a_0$. Bottom row: simulation minus exact gain.}}{16}{figure.8}\protected@file@percent }
\newlabel{fig:ti gain}{{8}{16}{Per-step gain of the broadcast regime, normalized by $\rho _0\lambda _0$, against the fraction of learned agents, for $L=128$, $\delta \lambda =0$, $0.2$, $0.4$, and $0.49$ (left to right), and $\rho _0=0.1$ (blue circles), $0.5$ (orange squares), and $0.9$ (green triangles). Symbols: simulation (agents newly learned divided by agents unlearned, summed over 20 runs within bins of $f$); solid lines: exact gain, Eq.~\eqref {eq:ti-exact-gain}; dashed lines: fitted constant $a_0$. Bottom row: simulation minus exact gain}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  Class-level comparison with the empirical data of Roxas (fourteen classes of 64 students; one point per class, using the class mean scores). (a)~Class mean post-test score against class mean pre-test score. The gray line represents $y=x$, the green line the prediction of~\citet  {nitta2019mathematical}, and the dashed line a free quadratic fitted to the class means (class 9 excluded), with $a_2=-0.67\pm 0.34$. (b)~Class Hake gain against class mean pre-test score, with the gain shapes of the two regimes, each with one fitted amplitude: constant gain (broadcast, solid blue) and $g\propto a_0-a_2f$ (nearest-neighbor, orange) with the coefficients of each of the four cases in Fig.~\ref {fig:Return map}; the four curves nearly coincide because $a_0\ll |a_2|$ in every case. The open marker is class 9, excluded from the fits as an outlier. }}{16}{figure.9}\protected@file@percent }
\newlabel{fig:Return map class}{{9}{16}{Class-level comparison with the empirical data of Roxas (fourteen classes of 64 students; one point per class, using the class mean scores). (a)~Class mean post-test score against class mean pre-test score. The gray line represents $y=x$, the green line the prediction of~\citet {nitta2019mathematical}, and the dashed line a free quadratic fitted to the class means (class 9 excluded), with $a_2=-0.67\pm 0.34$. (b)~Class Hake gain against class mean pre-test score, with the gain shapes of the two regimes, each with one fitted amplitude: constant gain (broadcast, solid blue) and $g\propto a_0-a_2f$ (nearest-neighbor, orange) with the coefficients of each of the four cases in Fig.~\ref {fig:Return map}; the four curves nearly coincide because $a_0\ll |a_2|$ in every case. The open marker is class 9, excluded from the fits as an outlier}{figure.9}{}}
