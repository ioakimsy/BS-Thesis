\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  Total relaxation time $t_{\rm  max}$ (solid lines, last agent learned) and $t_{95}$ (dashed lines, $95\%$ of agents learned) as functions of heterogeneity $\delta \lambda $, for the broadcast (blue) and nearest-neighbor (orange, inner corner seating) regimes, at $L=32$ (left column) and $L=128$ (right column) and $\rho _0=0.1$, $0.5$, and $0.9$ (rows), with $\lambda _0=0.5$ and four initially learned agents. Lines show the mean and bands one standard deviation over 20 runs; the vertical axis is logarithmic. }}{20}{figure.10}\protected@file@percent }
\newlabel{fig:t95 vs tmax}{{10}{20}{Total relaxation time $t_{\rm max}$ (solid lines, last agent learned) and $t_{95}$ (dashed lines, $95\%$ of agents learned) as functions of heterogeneity $\delta \lambda $, for the broadcast (blue) and nearest-neighbor (orange, inner corner seating) regimes, at $L=32$ (left column) and $L=128$ (right column) and $\rho _0=0.1$, $0.5$, and $0.9$ (rows), with $\lambda _0=0.5$ and four initially learned agents. Lines show the mean and bands one standard deviation over 20 runs; the vertical axis is logarithmic}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Return-map coefficients against lattice side $L$ (logarithmic axes for the nearest-neighbor coefficients) for $\rho _0\in \{0.1,0.5,0.9\}$ (colors) and $\delta \lambda \in \{0,0.2,0.4\}$ (rows); mean over 20 runs, each fitted separately, $\pm $ the standard error of the mean. Left: nearest-neighbor $a_0$. Center: nearest-neighbor $-a_2$. Right: broadcast $a_0$, normalized by $\rho _0\lambda _0$. Solid lines: four initially learned agents; dashed lines: fixed initial learned fraction. The legends give the log--log slopes.}}{21}{figure.11}\protected@file@percent }
\newlabel{fig:coefs vs L}{{11}{21}{Return-map coefficients against lattice side $L$ (logarithmic axes for the nearest-neighbor coefficients) for $\rho _0\in \{0.1,0.5,0.9\}$ (colors) and $\delta \lambda \in \{0,0.2,0.4\}$ (rows); mean over 20 runs, each fitted separately, $\pm $ the standard error of the mean. Left: nearest-neighbor $a_0$. Center: nearest-neighbor $-a_2$. Right: broadcast $a_0$, normalized by $\rho _0\lambda _0$. Solid lines: four initially learned agents; dashed lines: fixed initial learned fraction. The legends give the log--log slopes}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Size scaling of the nearest-neighbor regime with four initially learned agents (solid lines, circles) and with a fixed initial learned fraction (dashed lines, triangles). (a,~b)~$t_{\rm  max}$ against lattice side $L$ (logarithmic axes) for each seating arrangement, at $\rho _0=0.5$, $\delta \lambda =0.2$ and at $\rho _0=0.1$, $\delta \lambda =0.4$; the broadcast regime is shown in gray, and the legends give the scaling exponents $\gamma $ (log--log slopes). Lines show the mean and bands one standard deviation over 20 runs. (c)~Nearest-neighbor learning curves at $L=128$ with $4$ and $64$ initially learned agents. (d)~Scaling exponent $\gamma $ with a fixed initial learned fraction against $\gamma $ with four initially learned agents, for every combination of $\rho _0$ and $\delta \lambda $; points on the dotted line $y=x$ indicate that the size dependence is unaffected by the number of initially learned agents.}}{22}{figure.12}\protected@file@percent }
\newlabel{fig:seed density}{{12}{22}{Size scaling of the nearest-neighbor regime with four initially learned agents (solid lines, circles) and with a fixed initial learned fraction (dashed lines, triangles). (a,~b)~$t_{\rm max}$ against lattice side $L$ (logarithmic axes) for each seating arrangement, at $\rho _0=0.5$, $\delta \lambda =0.2$ and at $\rho _0=0.1$, $\delta \lambda =0.4$; the broadcast regime is shown in gray, and the legends give the scaling exponents $\gamma $ (log--log slopes). Lines show the mean and bands one standard deviation over 20 runs. (c)~Nearest-neighbor learning curves at $L=128$ with $4$ and $64$ initially learned agents. (d)~Scaling exponent $\gamma $ with a fixed initial learned fraction against $\gamma $ with four initially learned agents, for every combination of $\rho _0$ and $\delta \lambda $; points on the dotted line $y=x$ indicate that the size dependence is unaffected by the number of initially learned agents}{figure.12}{}}
