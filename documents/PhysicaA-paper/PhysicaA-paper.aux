\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Return-map fit statistics for the broadcast (TI) and nearest-neighbor (PI) regimes and the empirical data. Simulation fits impose $h(1)=1$; the broadcast form $h(f)=f+a_0(1-f)$ has the single free parameter $a_0$, and the nearest-neighbor form $h(f)=f+(1-f)(a_0-a_2 f)$ has free parameters $a_0$ and $a_2$. The empirical fit is a free quadratic $h(f)=a_0+a_1 f+a_2 f^2$. Uncertainties are one standard error from the Levenberg--Marquardt fit; $N_{\rm  pts}$ is the number of $(f_{t-1},f_t)$ pairs.}}{7}{table.3}\protected@file@percent }
\newlabel{tbl:returnmapfits}{{3}{7}{Return-map fit statistics for the broadcast (TI) and nearest-neighbor (PI) regimes and the empirical data. Simulation fits impose $h(1)=1$; the broadcast form $h(f)=f+a_0(1-f)$ has the single free parameter $a_0$, and the nearest-neighbor form $h(f)=f+(1-f)(a_0-a_2 f)$ has free parameters $a_0$ and $a_2$. The empirical fit is a free quadratic $h(f)=a_0+a_1 f+a_2 f^2$. Uncertainties are one standard error from the Levenberg--Marquardt fit; $N_{\rm pts}$ is the number of $(f_{t-1},f_t)$ pairs}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  Flowchart for the pCA algorithm used in this work. The broadcast (TI) and nearest-neighbor (PI) regimes differ in how the update probability $P_{i,j}$ is determined, as described in the text. }}{8}{figure.1}\protected@file@percent }
\newlabel{fig:pCA-flowchart}{{1}{8}{Flowchart for the pCA algorithm used in this work. The broadcast (TI) and nearest-neighbor (PI) regimes differ in how the update probability $P_{i,j}$ is determined, as described in the text}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  Seating arrangements (SAs) considered for the nearest-neighbor (PI) regime. Dots represent the initial positions of learned agents ($s_{i,j}=1$) in the lattice. Agents are otherwise arranged in a rectangular lattice pattern (shown here as square for brevity). The random case shown is one of many possible arrangements. }}{8}{figure.2}\protected@file@percent }
\newlabel{fig:PI-SAs}{{2}{8}{Seating arrangements (SAs) considered for the nearest-neighbor (PI) regime. Dots represent the initial positions of learned agents ($s_{i,j}=1$) in the lattice. Agents are otherwise arranged in a rectangular lattice pattern (shown here as square for brevity). The random case shown is one of many possible arrangements}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  Monotonic increase of the learned agent fraction over iteration number for both interaction regimes. The horizontal axis (iteration number) is shown on a base-2 logarithmic scale ($2^0, 2^1, 2^2, \dots  $). Blue corresponds to the broadcast (TI) regime; all other colors correspond to the nearest-neighbor (PI) regime. Bands represent the min-max range across $20$ independent randomized runs. (a)~Effect of lattice side length $L$ (line width proportional to lattice side length $L$); the inner corner SA is used for the nearest-neighbor regime; $\rho _0=0.5$, $\delta \lambda =0.2$. (b)~Effect of seating arrangement (SA) for a fixed lattice side length; colors indicate different SAs (yellow-orange: inner corner, orange: center, green: outer corner, pink: random); $\rho _0=0.5$, $\delta \lambda =0.2$. (c)~Effect of coupling strength $\rho _0$; inner corner SA, $L=64$, $\delta \lambda =0.2$. (d)~Effect of heterogeneity parameter $\delta \lambda $; inner corner SA, $L=64$, $\rho _0=0.5$. }}{9}{figure.3}\protected@file@percent }
\newlabel{fig:comparison size}{{3}{9}{Monotonic increase of the learned agent fraction over iteration number for both interaction regimes. The horizontal axis (iteration number) is shown on a base-2 logarithmic scale ($2^0, 2^1, 2^2, \dots $). Blue corresponds to the broadcast (TI) regime; all other colors correspond to the nearest-neighbor (PI) regime. Bands represent the min-max range across $20$ independent randomized runs. (a)~Effect of lattice side length $L$ (line width proportional to lattice side length $L$); the inner corner SA is used for the nearest-neighbor regime; $\rho _0=0.5$, $\delta \lambda =0.2$. (b)~Effect of seating arrangement (SA) for a fixed lattice side length; colors indicate different SAs (yellow-orange: inner corner, orange: center, green: outer corner, pink: random); $\rho _0=0.5$, $\delta \lambda =0.2$. (c)~Effect of coupling strength $\rho _0$; inner corner SA, $L=64$, $\delta \lambda =0.2$. (d)~Effect of heterogeneity parameter $\delta \lambda $; inner corner SA, $L=64$, $\rho _0=0.5$}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces  Representative spatial configurations of the lattice ($L=32$, $\rho _0=0.3$) at iteration numbers $t=2,8,16,32$, and $54$, for the broadcast (top row, ``Traditional'') and nearest-neighbor (bottom row, ``Peer'') regimes. Light blue indicates unlearned agents; blue and dark navy indicate learned agents with slow and fast learning rates $\lambda $, respectively. }}{9}{figure.4}\protected@file@percent }
\newlabel{fig:spatial config}{{4}{9}{Representative spatial configurations of the lattice ($L=32$, $\rho _0=0.3$) at iteration numbers $t=2,8,16,32$, and $54$, for the broadcast (top row, ``Traditional'') and nearest-neighbor (bottom row, ``Peer'') regimes. Light blue indicates unlearned agents; blue and dark navy indicate learned agents with slow and fast learning rates $\lambda $, respectively}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Total relaxation time $t_{\rm  max}$ as a function of coupling strength $\rho _0$ and heterogeneity $\delta \lambda $ for the broadcast (blue surface) and nearest-neighbor (orange surface) regimes, for two lattice side lengths: (a)~$L=32$ and (b)~$L=128$. The nearest-neighbor regime uses the inner corner seating arrangement. Lower $t_{\rm  max}$ indicates faster collective relaxation. }}{10}{figure.5}\protected@file@percent }
\newlabel{fig:Params effect summary t}{{5}{10}{Total relaxation time $t_{\rm max}$ as a function of coupling strength $\rho _0$ and heterogeneity $\delta \lambda $ for the broadcast (blue surface) and nearest-neighbor (orange surface) regimes, for two lattice side lengths: (a)~$L=32$ and (b)~$L=128$. The nearest-neighbor regime uses the inner corner seating arrangement. Lower $t_{\rm max}$ indicates faster collective relaxation}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Return map of the learned agent fraction $f_t$ against $f_{t-1}$ for selected parameter sets. Blue circles represent broadcast (TI) regime data points; orange squares represent nearest-neighbor (PI) regime data points; pink diamonds represent empirical data from Roxas (co-author). Darker points indicate higher overlap of data points at those coordinates. Dashed lines show the best-fit functions obtained using the Levenberg-Marquardt algorithm for each dataset. The green line represents the theoretical prediction of~\citet  {nitta2019mathematical} and the gray line represents $y=x$. (a)~Large lattice side length $L=128$. (b)~Small lattice side length $L=32$. }}{10}{figure.6}\protected@file@percent }
\newlabel{fig:Return map}{{6}{10}{Return map of the learned agent fraction $f_t$ against $f_{t-1}$ for selected parameter sets. Blue circles represent broadcast (TI) regime data points; orange squares represent nearest-neighbor (PI) regime data points; pink diamonds represent empirical data from Roxas (co-author). Darker points indicate higher overlap of data points at those coordinates. Dashed lines show the best-fit functions obtained using the Levenberg-Marquardt algorithm for each dataset. The green line represents the theoretical prediction of~\citet {nitta2019mathematical} and the gray line represents $y=x$. (a)~Large lattice side length $L=128$. (b)~Small lattice side length $L=32$}{figure.6}{}}
