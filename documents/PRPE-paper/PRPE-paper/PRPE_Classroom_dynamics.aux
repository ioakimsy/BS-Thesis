\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Time to learn $t_{\rm  max}$ as a function of positional learning factor $\rho _0$ and heterogeneity $\delta \lambda $ of PI (inner corner SA) and TI for two different class sizes $N=L^2$ ((a)$L=32$ and (b)$L=128$). The blue surface represent TI and the orange surface represents PI. Lower time to learn indicates better learning.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:Params effect summary t}{{5}{6}{Time to learn $t_{\rm max}$ as a function of positional learning factor $\rho _0$ and heterogeneity $\delta \lambda $ of PI (inner corner SA) and TI for two different class sizes $N=L^2$ ((a)$L=32$ and (b)$L=128$). The blue surface represent TI and the orange surface represents PI. Lower time to learn indicates better learning}{figure.5}{}}
\newlabel{eq:gain-from-return-map}{{6}{6}{}{equation.4.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Return map for selected parameter sets for both TI and PI. Blue circles represent the data points for TI and orange squares represent the data points for PI. Pink diamonds represent data points from Roxas' work\nobreakspace  {}\cite  {roxas2010seating} for comparison. The darker data points mean that more points overlap on those coordinates. The corresponding best-fit quadratic function obtained using the Levenberg-Marquardt algorithm for each set of data points are shown in dashed lines in their corresponding color and are discussed in the text. The green line represents Nitta's theoretical model (Equation\nobreakspace  {}\ref {eq:nitta_model}) and the gray line represents $y=x$.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:Return map}{{6}{6}{Return map for selected parameter sets for both TI and PI. Blue circles represent the data points for TI and orange squares represent the data points for PI. Pink diamonds represent data points from Roxas' work~\cite {roxas2010seating} for comparison. The darker data points mean that more points overlap on those coordinates. The corresponding best-fit quadratic function obtained using the Levenberg-Marquardt algorithm for each set of data points are shown in dashed lines in their corresponding color and are discussed in the text. The green line represents Nitta's theoretical model (Equation~\ref {eq:nitta_model}) and the gray line represents $y=x$}{figure.6}{}}
